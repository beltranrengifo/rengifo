---
import Logo from './Logo.astro';
import {
  t,
  resolveLocale,
  alternateHref,
  homeHref,
  localisedPath,
  formatSpan,
} from '../lib/i18n';
import { experience, type Span } from '../data/experience';
import { projects } from '../data/caseStudies';
import { techs, projectSpans, eras, boardWorks } from '../data/board';
import { buildModel, yearOf } from '../board/model';

const locale = resolveLocale(Astro.currentLocale);

const roleId = (titleKey: string) => titleKey.replace(/^exp_|_title$/g, '');
const techLabel = (label: (typeof techs)[number]['label']) =>
  typeof label === 'string' ? label : label[locale];

const roles = experience.flatMap((entry) =>
  entry.roles.map((role) => {
    const company = entry.companyKey
      ? t(entry.companyKey, locale)
      : (entry.company ?? '');
    const title = t(role.titleKey, locale);
    return {
      id: roleId(role.titleKey),
      kind: 'role' as const,
      // Short enough for a clip: the role, then the company.
      label: `${title.split(' — ')[0]!.split(', ')[0]} · ${company}`,
      title,
      company,
      span: role.dates ?? entry.period,
      blurbKey: role.blurbKey,
    };
  }),
);

const shownProjects = projects.map((project) => ({
  id: project.slug,
  kind: 'project' as const,
  label: project.name,
  span: projectSpans[project.slug]!,
  project,
}));

// Films and other work only the board shows; drawn like projects.
const works = boardWorks.map((work) => ({
  id: work.id,
  kind: 'project' as const,
  label: work.label,
  span: work.span,
  work,
}));

// Clips in time order, so Tab and the arrows walk the career forwards.
const clips = [...roles, ...shownProjects, ...works].sort(
  (a, b) => yearOf(a.span[0]) - yearOf(b.span[0]),
);

// Rows run front to back: what is built on top nearest, the roots behind.
const LAYER_ORDER = ['frontend', 'backend', 'tools', 'media'];
const rows = [...techs].sort(
  (a, b) => LAYER_ORDER.indexOf(a.layer) - LAYER_ORDER.indexOf(b.layer),
);

const model = buildModel({
  clips,
  techs: rows.map((tech) => ({ ...tech, label: techLabel(tech.label) })),
});

// What each node says on the board: short, like a chart's annotations.
const labels: Record<string, { title: string; sub?: string; years?: string }> =
  Object.fromEntries([
    ...roles.map((role) => [
      role.id,
      {
        title: role.company,
        sub: role.title.split(' — ')[0]!.split(', ')[0],
        years: formatSpan(role.span, locale),
      },
    ]),
    ...shownProjects.map((project) => [
      project.id,
      { title: project.label, years: formatSpan(project.span, locale) },
    ]),
    ...works.map((work) => [
      work.id,
      { title: work.label, years: work.span[0].slice(0, 4) },
    ]),
    ...rows.map((tech) => [
      `tech:${tech.id}`,
      { title: techLabel(tech.label) },
    ]),
  ]);

const boardData = {
  ...model,
  labels,
  eras: eras.map((era) => ({
    label: t(era.key, locale),
    start: era.start,
    end: era.end,
  })),
};

const spanOf = new Map<string, Span>(clips.map((c) => [c.id, c.span]));
const labelOf = new Map<string, string>(clips.map((c) => [c.id, c.label]));

const layerHeading = {
  backend: 'cap_h_backend',
  frontend: 'cap_h_frontend',
  tools: 'cap_h_infra',
  media: 'ui_board_layer_media',
} as const;

const caseStudyHref = (slug: string) =>
  localisedPath(`/work/${slug}/`, 'en', locale);
---

<div
  class="board"
  data-board
  role="region"
  aria-label={t('ui_board_label', locale)}
>
  <div class="board-stage" data-board-stage>
    <svg class="board-svg" data-board-svg aria-hidden="false"></svg>
  </div>

  <header class="board-bar">
    <a
      href={homeHref(locale)}
      class="board-home no-underline"
      aria-label="Beltrán Rengifo"
    >
      <Logo width={16} height={22} />
    </a>
    <p class="board-hint">{t('ui_board_hint', locale)}</p>
    <nav class="board-nav">
      <button type="button" class="board-reset" data-board-reset>
        {t('ui_board_reset', locale)}
      </button>
      <a href={alternateHref(locale, Astro.url.pathname)} class="no-underline">
        {t('ui_lang_switch', locale)}
      </a>
      <a href={homeHref(locale)} class="board-classic no-underline">
        {t('ui_board_classic', locale)}
      </a>
    </nav>
  </header>

  <aside class="board-panel" data-board-panel inert aria-live="polite">
    <div class="board-sheet-handle" data-sheet-handle aria-hidden="true"></div>
    <button type="button" class="board-close" data-board-close>
      {t('ui_board_close', locale)}
      <span aria-hidden="true">×</span>
    </button>

    {
      roles.map((role) => (
        <section data-panel={role.id} hidden>
          <p class="board-kicker">
            {role.company} · {formatSpan(role.span, locale)}
          </p>
          <h2>{role.title}</h2>
          <p>{t(role.blurbKey, locale)}</p>
        </section>
      ))
    }

    {
      shownProjects.map(({ id, span, project }) => (
        <section data-panel={id} hidden>
          <p class="board-kicker">
            {t('ui_board_kind_project', locale)} · {formatSpan(span, locale)}
          </p>
          <h2>{project.name}</h2>
          <p>{t(project.rowKey, locale)}</p>
          <p class="board-stack">{project.stack.join(' · ')}</p>
          {project.page !== false && (
            <a
              href={caseStudyHref(project.slug)}
              class="board-cta no-underline"
            >
              {t('ui_cs_read', locale)} <span aria-hidden="true">→</span>
            </a>
          )}
        </section>
      ))
    }

    {
      works.map(({ id, span, work }) => (
        <section data-panel={id} hidden>
          <p class="board-kicker">{span[0].slice(0, 4)}</p>
          <h2>{work.label}</h2>
          <p>{work.note[locale]}</p>
          {work.href && (
            <a
              href={work.href}
              target="_blank"
              rel="noopener"
              class="board-cta no-underline"
            >
              {t('ui_board_visit', locale)} <span aria-hidden="true">↗</span>
            </a>
          )}
        </section>
      ))
    }

    {
      techs.map((tech) => (
        <section data-panel={`tech:${tech.id}`} hidden>
          <p class="board-kicker">{t(layerHeading[tech.layer], locale)}</p>
          <h2>{techLabel(tech.label)}</h2>
          {tech.href && (
            <a
              href={tech.href}
              target="_blank"
              rel="noopener"
              class="board-cta no-underline"
            >
              {t('ui_board_visit', locale)} <span aria-hidden="true">↗</span>
            </a>
          )}
          <p class="board-used">{t('ui_board_used_in', locale)}</p>
          <ul class="board-uses">
            {Object.keys(tech.uses)
              .sort(
                (a, b) => yearOf(spanOf.get(a)![0]) - yearOf(spanOf.get(b)![0]),
              )
              .map((id) => (
                <li>
                  <button type="button" data-goto={id}>
                    <span>{labelOf.get(id)}</span>
                    <span class="board-years">
                      {formatSpan(spanOf.get(id)!, locale)}
                    </span>
                  </button>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </aside>

  <script
    type="application/json"
    data-board-model
    set:html={JSON.stringify(boardData)}
  />
</div>

<script>
  import '../board/main.ts';
</script>

<style is:global>
  .board {
    --board-bg: #f6f5f2;
    --board-ink: #16181a;
    --board-role: var(--accent);
    --board-project: #b8654a;
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--board-bg);
    color: var(--color-ink, #16181a);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .board-stage {
    position: absolute;
    inset: 0;
    cursor: grab;
  }
  .board[data-holding] .board-stage,
  .board-stage:active {
    cursor: grabbing;
  }
  .board-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* ── The chart: hairlines, small type, a lot of air ────────── */
  .board-year-line {
    stroke: var(--board-ink);
    stroke-opacity: 0.06;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .board-floor {
    stroke: var(--board-ink);
    stroke-opacity: 0.16;
    vector-effect: non-scaling-stroke;
  }
  .board-year {
    font: 500 11px var(--font-sans, system-ui, sans-serif);
    letter-spacing: 0.08em;
    fill: var(--board-ink);
    fill-opacity: 0.4;
  }
  .board-era-bracket {
    fill: none;
    stroke: var(--board-ink);
    stroke-opacity: 0.22;
    vector-effect: non-scaling-stroke;
  }
  .board-era {
    font: italic 300 17px var(--font-serif, Georgia, serif);
    fill: var(--board-ink);
    fill-opacity: 0.55;
  }

  .board-link {
    fill: none;
    stroke: var(--board-ink);
    stroke-opacity: calc(0.05 + var(--w, 1) * 0.045);
    stroke-width: calc(0.4px + var(--w, 1) * 0.3px);
    vector-effect: non-scaling-stroke;
    transition:
      stroke 0.3s ease,
      stroke-opacity 0.3s ease;
  }

  .board-node {
    cursor: pointer;
    outline: none;
    transition: opacity 0.3s ease;
  }
  .board-dot {
    vector-effect: non-scaling-stroke;
    transition:
      fill 0.3s ease,
      stroke 0.3s ease;
  }
  .board-node.is-role .board-dot {
    fill: #fbfaf8;
    stroke: var(--board-ink);
    stroke-width: 1;
  }
  .board-node.is-project .board-dot {
    fill: #fbfaf8;
    stroke: var(--board-project);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .board-node.is-tech .board-dot {
    fill: var(--board-ink);
  }
  .board-span {
    fill: none;
    stroke: var(--board-ink);
    stroke-opacity: 0.2;
    transition: opacity 0.3s ease;
    vector-effect: non-scaling-stroke;
  }
  .board-span.is-project {
    stroke: var(--board-project);
    stroke-opacity: 0.45;
  }
  .board-span.is-active {
    stroke: var(--accent);
    stroke-opacity: 0.7;
  }

  .board-title,
  .board-sub,
  .board-years-label {
    text-anchor: middle;
    fill: var(--board-ink);
  }
  .board-title {
    font: italic 400 16px var(--font-serif, Georgia, serif);
  }
  .board-node.is-project .board-title {
    font-size: 14px;
    fill: color-mix(in srgb, var(--board-project) 75%, var(--board-ink));
  }
  .board-sub {
    font: 500 10px var(--font-sans, system-ui, sans-serif);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill-opacity: 0.62;
  }
  .board-years-label {
    font: 400 10px var(--font-sans, system-ui, sans-serif);
    letter-spacing: 0.06em;
    fill-opacity: 0.42;
  }
  .board-tech-label {
    font: 500 11.5px var(--font-sans, system-ui, sans-serif);
    fill: var(--board-ink);
    fill-opacity: 0.75;
  }

  /* Focus: the node and its neighbours stay, everything else steps back. */
  .board-svg[data-focus] .board-node:not(.is-active, .is-related) {
    opacity: 0.16;
  }
  .board-svg[data-focus] .board-span:not(.is-active) {
    opacity: 0.2;
  }
  .board-svg[data-focus] .board-link:not(.is-active) {
    stroke-opacity: 0.025;
  }
  .board-link.is-active {
    stroke: var(--accent);
    stroke-opacity: 0.8;
  }
  .board-node.is-active .board-dot,
  .board-node.is-related.is-tech .board-dot {
    stroke: var(--accent);
  }
  .board-node.is-active.is-tech .board-dot,
  .board-node.is-related.is-tech .board-dot {
    fill: var(--accent);
  }
  .board-node.is-active.is-role .board-dot,
  .board-node.is-active.is-project .board-dot {
    fill: color-mix(in srgb, var(--accent) 8%, #fbfaf8);
    stroke-width: 1.5;
  }
  .board-node.is-active .board-title,
  .board-node.is-active .board-tech-label {
    fill: var(--accent);
    fill-opacity: 1;
  }
  .board-node:focus-visible .board-dot {
    stroke: var(--accent);
    stroke-width: 2;
  }

  /* Poncho, the board's companion (see companion.ts). */
  .poncho {
    cursor: pointer;
  }
  .poncho-meow {
    font: italic 400 13px var(--font-serif, Georgia, serif);
    fill: var(--board-ink);
  }
  .poncho-zzz {
    font: italic 300 14px var(--font-serif, Georgia, serif);
    fill: var(--board-ink);
    letter-spacing: 0.2em;
  }

  /* ── Bar ────────────────────────────────────────────────────── */
  .board-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 18px 24px;
    pointer-events: none;
  }
  .board-bar > * {
    pointer-events: auto;
  }
  .board-home {
    color: var(--color-ink, #16181a);
    display: inline-flex;
  }
  .board-hint {
    flex: 1;
    margin: 0;
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--color-muted, #5c6166);
  }
  .board-nav {
    display: flex;
    gap: 20px;
    font-size: 12.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .board-nav a {
    color: var(--color-muted, #5c6166);
  }
  .board-nav a:hover {
    color: var(--color-ink, #16181a);
  }
  .board-reset {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--color-muted, #5c6166);
    cursor: pointer;
  }
  .board-reset:hover {
    color: var(--color-ink, #16181a);
  }
  .board-classic {
    color: var(--color-ink, #16181a) !important;
  }

  /* ── Panel ──────────────────────────────────────────────────── */
  .board-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 420px;
    overflow-y: auto;
    padding: 72px 36px 48px;
    background: color-mix(in srgb, var(--board-bg) 94%, white);
    border-left: 1px solid rgba(22, 24, 26, 0.08);
    box-shadow: -24px 0 60px rgba(22, 24, 26, 0.06);
    user-select: text;
    -webkit-user-select: text;
    touch-action: pan-y;
    /* Slides in and out; the board eases aside in step (see main.ts). */
    transform: translateX(100%);
    visibility: hidden;
    transition:
      transform 0.55s cubic-bezier(0.22, 0.8, 0.2, 1),
      visibility 0s linear 0.55s;
  }
  .board-panel[data-open] {
    transform: none;
    visibility: visible;
    transition:
      transform 0.55s cubic-bezier(0.22, 0.8, 0.2, 1),
      visibility 0s;
  }
  .board-panel > section {
    transition: opacity 0.35s ease 0.12s;
  }
  .board-panel:not([data-open]) > section {
    opacity: 0;
  }
  .board-panel h2 {
    margin: 0 0 16px;
    font-size: 26px;
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .board-panel p {
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-body, #3a3d40);
  }
  .board-kicker {
    font-size: 12px !important;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted, #5c6166) !important;
  }
  .board-stack {
    font-size: 13px !important;
    color: var(--color-muted, #5c6166) !important;
  }
  .board-cta {
    display: inline-block;
    margin-top: 8px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .board-close {
    position: absolute;
    top: 20px;
    right: 24px;
    border: 0;
    background: none;
    font: 500 12px var(--font-sans, 'Schibsted Grotesk', system-ui, sans-serif);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted, #5c6166);
    cursor: pointer;
  }
  .board-close:hover {
    color: var(--color-ink, #16181a);
  }
  .board-used {
    margin-top: 6px !important;
    font-size: 12px !important;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted, #5c6166) !important;
  }
  .board-uses {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .board-uses button {
    display: flex;
    width: 100%;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid rgba(22, 24, 26, 0.08);
    background: none;
    font: 15px/1.4 var(--font-sans, 'Schibsted Grotesk', system-ui, sans-serif);
    text-align: left;
    color: var(--color-ink, #16181a);
    cursor: pointer;
  }
  .board-uses button:hover {
    color: var(--accent);
  }
  .board-years {
    flex-shrink: 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted, #5c6166);
  }
  .board-sheet-handle {
    display: none;
  }

  @media (max-width: 720px) {
    .board-hint {
      display: none;
    }
    .board-bar {
      justify-content: space-between;
    }
    .board-panel {
      top: auto;
      left: 0;
      width: auto;
      height: 86dvh;
      padding: 40px 22px 40px;
      border-left: 0;
      border-top: 1px solid rgba(22, 24, 26, 0.08);
      border-radius: 18px 18px 0 0;
      box-shadow: 0 -24px 60px rgba(22, 24, 26, 0.1);
      transform: translateY(100%);
    }
    .board-panel[data-open] {
      transform: none;
    }
    .board-sheet-handle {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 32px;
      touch-action: none;
    }
    .board-sheet-handle::after {
      content: '';
      position: absolute;
      top: 12px;
      left: 50%;
      width: 44px;
      height: 4px;
      margin-left: -22px;
      border-radius: 4px;
      background: rgba(22, 24, 26, 0.18);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .board-panel,
    .board-panel[data-open] {
      transition: none;
    }
  }
</style>
