---
import Logo from './Logo.astro';
import {
  t,
  resolveLocale,
  alternateHref,
  homeHref,
  localisedPath,
  formatSpan,
} from '../lib/i18n';
import { experience, type Span } from '../data/experience';
import { projects } from '../data/caseStudies';
import { techs, projectSpans, eras, boardWorks } from '../data/board';
import { buildModel, yearOf } from '../board/model';

const locale = resolveLocale(Astro.currentLocale);

const roleId = (titleKey: string) => titleKey.replace(/^exp_|_title$/g, '');
const techLabel = (label: (typeof techs)[number]['label']) =>
  typeof label === 'string' ? label : label[locale];

const roles = experience.flatMap((entry) =>
  entry.roles.map((role) => {
    const company = entry.companyKey
      ? t(entry.companyKey, locale)
      : (entry.company ?? '');
    const title = t(role.titleKey, locale);
    return {
      id: roleId(role.titleKey),
      kind: 'role' as const,
      // Short enough for a clip: the role, then the company.
      label: `${title.split(' — ')[0]!.split(', ')[0]} · ${company}`,
      title,
      company,
      companyHref: entry.companyHref,
      span: role.dates ?? entry.period,
      blurbKey: role.blurbKey,
    };
  }),
);

const shownProjects = projects.map((project) => ({
  id: project.slug,
  kind: 'project' as const,
  label: project.name,
  span: projectSpans[project.slug]!,
  project,
}));

// Films and other work only the board shows; drawn like projects.
const works = boardWorks.map((work) => ({
  id: work.id,
  kind: 'project' as const,
  label: work.label,
  span: work.span,
  work,
}));

// Clips in time order, so Tab and the arrows walk the career forwards.
const clips = [...roles, ...shownProjects, ...works].sort(
  (a, b) => yearOf(a.span[0]) - yearOf(b.span[0]),
);

// Rows run front to back: what is built on top nearest, the roots behind.
const LAYER_ORDER = ['frontend', 'backend', 'tools', 'practice', 'media'];
const rows = [...techs].sort(
  (a, b) => LAYER_ORDER.indexOf(a.layer) - LAYER_ORDER.indexOf(b.layer),
);

const model = buildModel({
  clips,
  techs: rows.map((tech) => ({ ...tech, label: techLabel(tech.label) })),
});

// What each node says on the board: short, like a chart's annotations.
const labels: Record<string, { title: string; sub?: string; years?: string }> =
  Object.fromEntries([
    ...roles.map((role) => [
      role.id,
      {
        title: role.company,
        sub: role.title.split(' — ')[0]!.split(', ')[0],
        years: formatSpan(role.span, locale),
      },
    ]),
    ...shownProjects.map((project) => [
      project.id,
      { title: project.label, years: formatSpan(project.span, locale) },
    ]),
    ...works.map((work) => [
      work.id,
      { title: work.label, years: work.span[0].slice(0, 4) },
    ]),
    ...rows.map((tech) => [
      `tech:${tech.id}`,
      { title: techLabel(tech.label) },
    ]),
  ]);

const boardData = {
  ...model,
  labels,
  eras: eras.map((era) => ({
    label: t(era.key, locale),
    start: era.start,
    end: era.end,
  })),
};

const spanOf = new Map<string, Span>(clips.map((c) => [c.id, c.span]));
const labelOf = new Map<string, string>(clips.map((c) => [c.id, c.label]));

// The technologies a node used, heaviest first, with their berry's colour
// (see board/fruit.ts), for the chips in its panel.
const BERRY: Record<string, string> = {
  backend: '#b5483f',
  frontend: '#5f7299',
  tools: '#8d73a0',
  media: '#c25a6c',
  practice: '#c8574a',
};
const techsOf = (id: string) =>
  techs
    .filter((tech) => tech.uses[id])
    .sort((a, b) => b.uses[id]! - a.uses[id]!)
    .map((tech) => ({
      id: `tech:${tech.id}`,
      label: techLabel(tech.label),
      colour: BERRY[tech.layer] ?? '#b5483f',
    }));

const layerHeading = {
  backend: 'cap_h_backend',
  frontend: 'cap_h_frontend',
  tools: 'cap_h_infra',
  media: 'ui_board_layer_media',
  practice: 'cap_h_practice',
} as const;

const caseStudyHref = (slug: string) =>
  localisedPath(`/work/${slug}/`, 'en', locale);
---

<div
  class="board"
  data-board
  role="region"
  aria-label={t('ui_board_label', locale)}
>
  <div class="board-stage" data-board-stage>
    <svg class="board-svg" data-board-svg aria-hidden="false"></svg>
  </div>

  <header class="board-bar">
    <a
      href={homeHref(locale)}
      class="board-home no-underline"
      aria-label={t('ui_board_home', locale)}
      title={t('ui_board_home', locale)}
    >
      <Logo width={16} height={22} />
    </a>
  </header>

  <footer class="board-foot">
    <div class="board-help">
      <button
        type="button"
        class="board-icon"
        data-board-help
        aria-expanded="false"
        aria-controls="board-help"
        aria-label={t('ui_board_help', locale)}
        title={t('ui_board_help', locale)}
      >
        ?
      </button>
      <div class="board-help-pop" id="board-help" hidden>
        <p>{t('ui_board_hint_travel', locale)}</p>
        <p>{t('ui_board_hint_zoom', locale)}</p>
        <p>{t('ui_board_hint_move', locale)}</p>
      </div>
    </div>
    <nav class="board-foot-nav">
      <button type="button" class="board-text-button" data-board-reset>
        {t('ui_board_reset', locale)}
      </button>
      <a href={alternateHref(locale, Astro.url.pathname)} class="no-underline">
        {t('ui_lang_switch', locale)}
      </a>
    </nav>
  </footer>

  <aside class="board-panel" data-board-panel inert aria-live="polite">
    <div class="board-sheet-handle" data-sheet-handle aria-hidden="true"></div>
    <button
      type="button"
      class="board-close"
      data-board-close
      aria-label={t('ui_board_close', locale)}
    >
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M3 3 L13 13 M13 3 L3 13"></path>
      </svg>
    </button>

    {
      roles.map((role) => (
        <section data-panel={role.id} hidden>
          <p class="board-kicker">
            {role.companyHref ? (
              <a
                href={role.companyHref}
                target="_blank"
                rel="noopener"
                class="board-company"
              >
                {role.company}
              </a>
            ) : (
              role.company
            )}{' '}
            · {formatSpan(role.span, locale)}
          </p>
          <h2>{role.title}</h2>
          <p>{t(role.blurbKey, locale)}</p>
          {role.id === 'prev' && (
            <p class="board-note">{t('ui_board_highlights_note', locale)}</p>
          )}
          {techsOf(role.id).length > 0 && (
            <>
              <p class="board-used">{t('ui_board_techs', locale)}</p>
              <ul class="board-chips">
                {techsOf(role.id).map((tech) => (
                  <li>
                    <button
                      type="button"
                      data-goto={tech.id}
                      style={`--berry: ${tech.colour}`}
                    >
                      {tech.label}
                    </button>
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>
      ))
    }

    {
      shownProjects.map(({ id, span, project }) => (
        <section data-panel={id} hidden>
          <p class="board-kicker">
            {t('ui_board_kind_project', locale)} · {formatSpan(span, locale)}
          </p>
          <h2>{project.name}</h2>
          <p>{t(project.rowKey, locale)}</p>
          {techsOf(id).length > 0 && (
            <>
              <p class="board-used">{t('ui_board_techs', locale)}</p>
              <ul class="board-chips">
                {techsOf(id).map((tech) => (
                  <li>
                    <button
                      type="button"
                      data-goto={tech.id}
                      style={`--berry: ${tech.colour}`}
                    >
                      {tech.label}
                    </button>
                  </li>
                ))}
              </ul>
            </>
          )}
          {project.page !== false && (
            <a
              href={caseStudyHref(project.slug)}
              class="board-cta no-underline"
            >
              {t('ui_cs_read', locale)} <span aria-hidden="true">→</span>
            </a>
          )}
        </section>
      ))
    }

    {
      works.map(({ id, span, work }) => (
        <section data-panel={id} hidden>
          <p class="board-kicker">
            {t('ui_board_highlight', locale)} · {span[0].slice(0, 4)}
          </p>
          <h2>{work.label}</h2>
          <p>{work.note[locale]}</p>
          <dl class="board-facts">
            {work.facts.map(({ label, value }) => (
              <>
                <dt>{label[locale]}</dt>
                <dd>{typeof value === 'string' ? value : value[locale]}</dd>
              </>
            ))}
          </dl>
          {techsOf(id).length > 0 && (
            <>
              <p class="board-used">{t('ui_board_techs', locale)}</p>
              <ul class="board-chips">
                {techsOf(id).map((tech) => (
                  <li>
                    <button
                      type="button"
                      data-goto={tech.id}
                      style={`--berry: ${tech.colour}`}
                    >
                      {tech.label}
                    </button>
                  </li>
                ))}
              </ul>
            </>
          )}
          {work.watch && (
            <a
              href={work.watch}
              target="_blank"
              rel="noopener"
              class="board-cta no-underline"
            >
              {t('ui_board_watch', locale)} <span aria-hidden="true">↗</span>
            </a>
          )}
        </section>
      ))
    }

    {
      techs.map((tech) => (
        <section data-panel={`tech:${tech.id}`} hidden>
          <p class="board-kicker">{t(layerHeading[tech.layer], locale)}</p>
          <h2>{techLabel(tech.label)}</h2>
          <p class="board-used">{t('ui_board_used_in', locale)}</p>
          <ul class="board-uses">
            {Object.keys(tech.uses)
              .sort(
                (a, b) => yearOf(spanOf.get(a)![0]) - yearOf(spanOf.get(b)![0]),
              )
              .map((id) => (
                <li>
                  <button type="button" data-goto={id}>
                    <span>{labelOf.get(id)}</span>
                    <span class="board-years">
                      {formatSpan(spanOf.get(id)!, locale)}
                    </span>
                  </button>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </aside>

  <script
    type="application/json"
    data-board-model
    set:html={JSON.stringify(boardData)}
  />
</div>

<script>
  import '../board/main.ts';
</script>

<style is:global>
  .board {
    --board-bg: #f6f5f2;
    --board-ink: #16181a;
    --board-role: var(--accent);
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--board-bg);
    color: var(--color-ink, #16181a);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .board-stage {
    position: absolute;
    inset: 0;
    cursor: grab;
  }
  .board[data-holding] .board-stage,
  .board-stage:active {
    cursor: grabbing;
  }
  .board-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* ── The chart: hairlines, small type, a lot of air ────────── */
  .board-year-line {
    stroke: var(--board-ink);
    stroke-opacity: 0.06;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .board-floor {
    stroke: var(--board-ink);
    stroke-opacity: 0.16;
    vector-effect: non-scaling-stroke;
  }
  .board-year {
    font: 500 11px var(--font-sans, system-ui, sans-serif);
    letter-spacing: 0.08em;
    fill: var(--board-ink);
    fill-opacity: 0.4;
  }
  .board-era-bracket {
    fill: none;
    stroke: var(--board-ink);
    stroke-opacity: 0.22;
    vector-effect: non-scaling-stroke;
  }
  .board-era {
    font: italic 300 17px var(--font-serif, Georgia, serif);
    fill: var(--board-ink);
    fill-opacity: 0.55;
  }

  .board-link {
    fill: none;
    stroke: var(--board-ink);
    stroke-opacity: calc(0.05 + var(--w, 1) * 0.045);
    stroke-width: calc(0.4px + var(--w, 1) * 0.3px);
    vector-effect: non-scaling-stroke;
    transition:
      stroke 0.3s ease,
      stroke-opacity 0.3s ease;
  }

  .board-node {
    cursor: pointer;
    outline: none;
    transition: opacity 0.3s ease;
  }
  .board-dot {
    vector-effect: non-scaling-stroke;
    transition:
      fill 0.3s ease,
      stroke 0.3s ease;
  }
  /* Every node is fruit; its circle stays as an invisible hit area. */
  .board-node .board-dot {
    fill: transparent;
    stroke: none;
  }
  .fruit-body {
    stroke: var(--board-ink);
    stroke-opacity: 0.55;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition:
      stroke 0.3s ease,
      stroke-opacity 0.3s ease;
  }
  .board-node.is-active .fruit-body,
  .board-node.is-related.is-tech .fruit-body,
  .board-node:focus-visible .fruit-body {
    stroke: var(--accent);
    stroke-opacity: 1;
    stroke-width: 1.8;
  }

  .board-title,
  .board-sub,
  .board-years-label {
    text-anchor: middle;
    fill: var(--board-ink);
  }
  .board-title {
    font: italic 400 16px var(--font-serif, Georgia, serif);
  }
  .board-sub {
    font: 500 10px var(--font-sans, system-ui, sans-serif);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill-opacity: 0.62;
  }
  .board-years-label {
    font: 400 10px var(--font-sans, system-ui, sans-serif);
    letter-spacing: 0.06em;
    fill-opacity: 0.42;
  }
  .board-tech-label {
    font: 500 11.5px var(--font-sans, system-ui, sans-serif);
    fill: var(--board-ink);
    fill-opacity: 0.75;
  }

  /* Focus: the node and its neighbours stay, everything else steps back. */
  .board-svg[data-focus] .board-node:not(.is-active, .is-related) {
    opacity: 0.16;
  }
  .board-svg[data-focus] .board-link:not(.is-active) {
    stroke-opacity: 0.025;
  }
  .board-link.is-active {
    stroke: var(--accent);
    stroke-opacity: 0.8;
  }
  .board-node.is-active .board-title,
  .board-node.is-active .board-tech-label {
    fill: var(--accent);
    fill-opacity: 1;
  }

  /* Poncho, the board's companion (see companion.ts). */
  .poncho {
    cursor: pointer;
  }
  .poncho-meow {
    font: italic 400 13px var(--font-serif, Georgia, serif);
    fill: var(--board-ink);
  }
  .poncho-purr {
    font: italic 400 12px var(--font-serif, Georgia, serif);
    fill: var(--board-ink);
    letter-spacing: 0.15em;
  }
  .poncho-zzz {
    font: italic 300 14px var(--font-serif, Georgia, serif);
    fill: var(--board-ink);
    letter-spacing: 0.2em;
  }

  /* ── Chrome: the logo top left, everything else quiet at the bottom ── */
  .board-bar {
    position: absolute;
    top: 0;
    left: 0;
    padding: 18px 24px;
  }
  .board-home {
    color: var(--color-ink, #16181a);
    display: inline-flex;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }
  .board-home:hover {
    opacity: 1;
  }
  .board-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 16px 24px calc(16px + env(safe-area-inset-bottom, 0px));
    pointer-events: none;
  }
  .board-foot > * {
    pointer-events: auto;
  }
  .board-help {
    position: relative;
  }
  .board-icon {
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid rgba(22, 24, 26, 0.18);
    border-radius: 50%;
    background: color-mix(in srgb, var(--board-bg) 85%, white);
    font: 500 13px var(--font-sans, system-ui, sans-serif);
    color: var(--color-muted, #5c6166);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .board-icon:hover,
  .board-icon[aria-expanded='true'] {
    color: var(--color-ink, #16181a);
    border-color: rgba(22, 24, 26, 0.4);
  }
  .board-help-pop {
    position: absolute;
    bottom: 40px;
    left: 0;
    width: max-content;
    max-width: min(320px, calc(100vw - 48px));
    padding: 14px 16px;
    border: 1px solid rgba(22, 24, 26, 0.1);
    border-radius: 10px;
    background: color-mix(in srgb, var(--board-bg) 92%, white);
    box-shadow: 0 12px 30px rgba(22, 24, 26, 0.08);
  }
  .board-help-pop p {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-ink, #16181a);
  }
  .board-help-pop p + p {
    margin-top: 6px;
  }
  .board-foot-nav {
    display: flex;
    gap: 18px;
    align-items: center;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .board-foot-nav a,
  .board-text-button {
    color: var(--color-muted, #5c6166);
  }
  .board-text-button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }
  .board-foot-nav a:hover,
  .board-text-button:hover {
    color: var(--color-ink, #16181a);
  }

  /* ── Panel ──────────────────────────────────────────────────── */
  .board-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    /* Wide enough to read: about 60 characters a line. */
    width: clamp(460px, 40vw, 660px);
    overflow-y: auto;
    padding: 56px 56px 56px;
    background: color-mix(in srgb, var(--board-bg) 94%, white);
    border-left: 1px solid rgba(22, 24, 26, 0.08);
    box-shadow: -24px 0 60px rgba(22, 24, 26, 0.06);
    user-select: text;
    -webkit-user-select: text;
    touch-action: pan-y;
    /* Slides in and out; the board eases aside in step (see main.ts). */
    transform: translateX(100%);
    visibility: hidden;
    transition:
      transform 0.55s cubic-bezier(0.22, 0.8, 0.2, 1),
      visibility 0s linear 0.55s;
  }
  .board-panel[data-open] {
    transform: none;
    visibility: visible;
    transition:
      transform 0.55s cubic-bezier(0.22, 0.8, 0.2, 1),
      visibility 0s;
  }
  .board-panel > section {
    transition: opacity 0.35s ease 0.12s;
  }
  .board-panel:not([data-open]) > section {
    opacity: 0;
  }
  .board-panel h2 {
    margin: 0 0 20px;
    font: italic 400 38px/1.1 var(--font-serif, Georgia, serif);
    letter-spacing: -0.01em;
  }
  .board-panel p {
    max-width: 62ch;
    margin: 0 0 16px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-body, #3a3d40);
  }
  .board-kicker {
    font-size: 12px !important;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted, #5c6166) !important;
  }
  .board-facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 18px;
    margin: 18px 0;
    padding-top: 16px;
    border-top: 1px solid rgba(22, 24, 26, 0.08);
    font-size: 14px;
    line-height: 1.5;
  }
  .board-facts dt {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted, #5c6166);
    padding-top: 2px;
  }
  .board-facts dd {
    margin: 0;
    color: var(--color-ink, #16181a);
  }
  /* The company links out, quietly, as on the classic page. */
  .board-company {
    color: inherit;
  }
  .board-company:hover {
    color: var(--accent);
  }
  .board-note {
    padding-top: 12px;
    border-top: 1px solid rgba(22, 24, 26, 0.08);
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    color: var(--color-muted, #5c6166) !important;
  }
  .board-stack {
    font-size: 13px !important;
    color: var(--color-muted, #5c6166) !important;
  }
  .board-cta {
    display: inline-block;
    margin-top: 8px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  /* A thin cross, nothing else: the panel's only way out besides Esc. */
  .board-close {
    position: absolute;
    top: 18px;
    right: 18px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-muted, #5c6166);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .board-close svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
  }
  .board-close:hover {
    background: rgba(22, 24, 26, 0.06);
    color: var(--color-ink, #16181a);
  }
  .board-close:focus-visible {
    outline: 1.5px solid var(--accent);
    outline-offset: 2px;
  }
  .board-used {
    margin-top: 6px !important;
    font-size: 12px !important;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted, #5c6166) !important;
  }
  .board-uses {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .board-uses button {
    display: flex;
    width: 100%;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid rgba(22, 24, 26, 0.08);
    background: none;
    font: 15px/1.4 var(--font-sans, 'Schibsted Grotesk', system-ui, sans-serif);
