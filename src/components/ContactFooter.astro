---
import Logo from './Logo.astro';
import {
  t,
  resolveLocale,
  contact,
  currentYear,
  pdfHref,
  localisedPath,
} from '../lib/i18n';

const locale = resolveLocale(Astro.currentLocale);
---

<section id="contact" class="bg-ink text-canvas relative">
  <div
    class="mx-auto max-w-[1080px] px-6 pt-[80px] pb-[64px] sm:px-10 sm:pt-[110px] sm:pb-[90px]"
  >
    <Logo width={26} height={35} class="text-canvas mb-10 block" data-reveal />

    <h2
      data-reveal
      class="m-0 mb-12 max-w-[760px] font-serif text-[clamp(34px,5vw,56px)] leading-[1.15] font-light tracking-[-0.01em] italic"
    >
      {t('ui_footer_headline', locale)}
    </h2>

    <div data-reveal class="flex flex-wrap items-center gap-9 text-[16px]">
      <a
        href={`mailto:${contact.email}`}
        data-copy={contact.email}
        class="footer-link">{contact.email}</a
      >
      <span
        class="font-serif text-[color-mix(in_srgb,var(--color-canvas)_60%,transparent)] italic"
      >
        {t('ui_footer_gmail_aside', locale)}{' '}
        <a
          href={`mailto:${contact.gmail}`}
          data-copy={contact.gmail}
          class="footer-link font-sans text-[16px] not-italic"
          >{contact.gmail}</a
        >
      </span>
      <a
        href={contact.linkedin}
        target="_blank"
        rel="noopener"
        class="footer-link">LinkedIn</a
      >
      <a
        href={contact.github}
        target="_blank"
        rel="noopener"
        class="footer-link">GitHub</a
      >
      <a
        href={pdfHref(locale)}
        download
        data-no-print
        class="footer-pdf rounded-xs border border-[color-mix(in_srgb,var(--color-canvas)_35%,transparent)] px-5 py-[10px] font-sans text-[13px] tracking-[0.14em] uppercase no-underline transition-all duration-200"
      >
        {t('ui_download_pdf', locale)}
      </a>
    </div>

    <p
      class="mt-[90px] text-[13px] tracking-[0.1em] text-[color-mix(in_srgb,var(--color-canvas)_45%,transparent)]"
    >
      {t('ui_footer_legal', locale, { year: currentYear })}
    </p>
  </div>

  {
    /*
     * Poncho, the same cat as on the board — hover him. He is also the
     * secret door to board mode: no link announces it, the cat is the link.
     */
  }
  <a
    href={localisedPath('/board/', 'en', locale)}
    aria-label={t('ui_board_link', locale)}
    title={`${t('ui_board_link', locale)} ${t('ui_board_link_aside', locale)}`}
    class="pointer-events-auto flex justify-center pb-10 no-underline sm:absolute sm:right-6 sm:bottom-3 sm:block sm:pb-0"
    data-no-print
  >
    <svg
      class="poncho-footer"
      data-poncho-footer
      viewBox="-60 -140 130 148"
      width="130"
      height="148"
      aria-hidden="true"></svg>
  </a>
</section>

<style>
  .footer-link {
    color: var(--color-canvas);
    text-decoration-color: color-mix(
      in srgb,
      var(--color-canvas) 40%,
      transparent
    );
  }
  /* Room above for the hop and the "miau", and never clipped. */
  .poncho-footer {
    overflow: visible;
  }
  .poncho-footer :global(.poncho-purr),
  .poncho-footer :global(.poncho-meow),
  .poncho-footer :global(.poncho-zzz) {
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-size: 12px;
    letter-spacing: 0.15em;
  }
  .poncho-footer :global(.poncho-purr),
  .poncho-footer :global(.poncho-meow),
  .poncho-footer :global(.poncho-zzz) {
    fill: color-mix(in srgb, var(--color-canvas) 70%, transparent);
  }
  .footer-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* Scoped rather than utilities: the global `a` colour is unlayered, so it
     beats Tailwind's text-canvas and left the label ink on ink. */
  .footer-pdf {
    color: var(--color-canvas);
  }
  .footer-pdf:hover {
    background: var(--color-canvas);
    color: var(--color-ink);
  }
</style>

<script>
  import '../scripts/poncho-footer.ts';
</script>
