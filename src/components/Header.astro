---
import Logo from './Logo.astro';
import {
  t,
  resolveLocale,
  alternateHref,
  homeHref,
  pdfHref,
} from '../lib/i18n';

const locale = resolveLocale(Astro.currentLocale);

// Themes, each shown by its accent; the names match :root[data-theme] in
// global.css. Blue is the default and sets no attribute.
const themes = [
  { id: 'blue', swatch: '#2a62a6', name: t('ui_accent_blue', locale) },
  { id: 'ink', swatch: '#16181a', name: t('ui_accent_ink', locale) },
  { id: 'sage', swatch: '#4d7a47', name: t('ui_accent_sage', locale) },
  {
    id: 'terracotta',
    swatch: '#b4532f',
    name: t('ui_accent_terracotta', locale),
  },
];
---

<header
  data-no-print
  data-header
  class="group sticky top-0 z-50 flex items-center justify-between bg-[color-mix(in_srgb,var(--color-canvas)_88%,transparent)] px-6 py-5 backdrop-blur-md transition-[padding] duration-300 ease-out data-[scrolled]:py-[7px] sm:px-10"
>
  <a
    href={homeHref(locale)}
    aria-label="Beltrán Rengifo"
    class="text-ink inline-flex no-underline"
  >
    <span
      class="inline-flex origin-left transition-transform duration-300 ease-out group-data-[scrolled]:scale-[0.8]"
    >
      <Logo width={18} height={24} />
    </span>
  </a>
  <nav class="flex items-center gap-7">
    <div
      role="radiogroup"
      aria-label={t('ui_accent_label', locale)}
      class="accent-picker"
    >
      {
        themes.map((theme, i) => (
          <button
            type="button"
            role="radio"
            aria-checked={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            aria-label={theme.name}
            title={theme.name}
            data-theme-option={theme.id}
            style={`--swatch: ${theme.swatch}`}
          />
        ))
      }
    </div>
    <a
      href={alternateHref(locale, Astro.url.pathname)}
      class="text-muted hover:text-ink font-sans text-[13px] tracking-[0.14em] uppercase no-underline transition-colors"
    >
      {t('ui_lang_switch', locale)}
    </a>
    <a
      href={pdfHref(locale)}
      download
      class="text-ink hover:border-ink hover:bg-ink hover:text-canvas rounded-xs border border-[color-mix(in_srgb,var(--color-ink)_25%,transparent)] px-[18px] py-[9px] font-sans text-[13px] tracking-[0.14em] uppercase no-underline transition-all duration-200 group-data-[scrolled]:px-[12px] group-data-[scrolled]:py-[3px]"
    >
      PDF
    </a>
  </nav>
</header>
