---
import Logo from './Logo.astro';
import {
  t,
  resolveLocale,
  alternateHref,
  homeHref,
  pdfHref,
} from '../lib/i18n';

const locale = resolveLocale(Astro.currentLocale);

// Kept in step with ACCENTS in scripts/resume.ts.
const accents = [
  { value: '#2f5d8a', name: t('ui_accent_blue', locale) },
  { value: '#16181a', name: t('ui_accent_ink', locale) },
  { value: '#6b705c', name: t('ui_accent_sage', locale) },
  { value: '#8c4a3b', name: t('ui_accent_terracotta', locale) },
];
---

<header
  data-no-print
  data-header
  class="group sticky top-0 z-50 flex items-center justify-between bg-[rgba(246,245,242,0.88)] px-6 py-5 backdrop-blur-md transition-[padding] duration-300 ease-out data-[scrolled]:py-[7px] sm:px-10"
>
  <a
    href={homeHref(locale)}
    aria-label="Beltrán Rengifo"
    class="text-ink inline-flex no-underline"
  >
    <span
      class="inline-flex origin-left transition-transform duration-300 ease-out group-data-[scrolled]:scale-[0.8]"
    >
      <Logo width={18} height={24} />
    </span>
  </a>
  <nav class="flex items-center gap-7">
    <div
      role="radiogroup"
      aria-label={t('ui_accent_label', locale)}
      class="accent-picker"
    >
      {
        accents.map((accent, i) => (
          <button
            type="button"
            role="radio"
            aria-checked={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            aria-label={accent.name}
            title={accent.name}
            data-accent={accent.value}
            style={`--swatch: ${accent.value}`}
          />
        ))
      }
    </div>
    <a
      href={alternateHref(locale, Astro.url.pathname)}
      class="text-muted hover:text-ink font-sans text-[13px] tracking-[0.14em] uppercase no-underline transition-colors"
    >
      {t('ui_lang_switch', locale)}
    </a>
    <a
      href={pdfHref(locale)}
      download
      class="text-ink hover:border-ink hover:bg-ink hover:text-canvas rounded-xs border border-[rgba(22,24,26,0.25)] px-[18px] py-[9px] font-sans text-[13px] tracking-[0.14em] uppercase no-underline transition-all duration-200 group-data-[scrolled]:px-[12px] group-data-[scrolled]:py-[3px]"
    >
      PDF
    </a>
  </nav>
</header>
