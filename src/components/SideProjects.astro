---
import SectionHeader from './SectionHeader.astro';
import { t, resolveLocale, localisedPath } from '../lib/i18n';
import { projects, type Project } from '../data/caseStudies';

const locale = resolveLocale(Astro.currentLocale);

/**
 * A case study lives on this site, so it stays in the visitor's language; a
 * project without a page goes straight to the live site.
 */
const projectHref = (project: Project): string =>
  project.page === false
    ? project.href
    : localisedPath(`/work/${project.slug}/`, 'en', locale);

const external = (project: Project) =>
  project.page === false ? { target: '_blank', rel: 'noopener' } : {};
---

<section id="work" class="mx-auto max-w-[1080px] px-6 pb-10 sm:px-10">
  <SectionHeader number="02" titleKey="ui_section_projects" class="mb-12" />

  <div class="grid">
    {
      projects.map((project, i) => {
        const isLast = i === projects.length - 1;
        return (
          <div
            data-reveal
            class:list={[
              'grid grid-cols-1 gap-2 sm:grid-cols-[minmax(140px,220px)_1fr] sm:gap-6',
              isLast
                ? 'border-b-0 px-0 pt-7 pb-16'
                : 'proj-row border-hairline -mx-6 rounded-xs border-b px-6 py-7',
            ]}
          >
            <a
              href={projectHref(project)}
              {...external(project)}
              class="proj-link m-0 font-serif text-[20px] italic"
            >
              {project.name}
            </a>
            <div class="mt-[2px]">
              <p class="text-muted m-0 text-[15px]">
                {t(project.rowKey, locale)}
              </p>
              <p class="text-faint mt-2 mb-0 text-[13px]">
                {project.stack.join(' · ')}
              </p>
              {/* The affordance the row was missing: an explicit way in. */}
              <a
                href={projectHref(project)}
                {...external(project)}
                class="proj-cta mt-3 inline-block text-[13px] tracking-[0.14em] uppercase"
              >
                {project.page === false ? (
                  <>
                    {t('ui_cs_live', locale)} <span aria-hidden="true">↗</span>
                  </>
                ) : (
                  <>
                    {t('ui_cs_read', locale)} <span aria-hidden="true">→</span>
                  </>
                )}
              </a>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .proj-row {
    transition: background 0.45s ease;
  }
  .proj-row:hover {
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }
  .proj-link {
    color: inherit;
    text-decoration: none;
  }
  .proj-link:hover {
    color: var(--accent);
  }

  /* The way in. Quiet at rest, accent on hover — like the row itself. */
  .proj-cta {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .proj-cta:hover,
  .proj-row:hover .proj-cta {
    color: var(--accent);
  }
</style>
