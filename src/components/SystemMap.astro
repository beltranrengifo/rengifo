---
/*
 * An explorable map of how a system fits together. Zones hold the parts;
 * a part opens its panel (what it is, what it does, what it talks to); a
 * walkthrough lights a path through the map one step at a time.
 *
 * The data lives in src/data/systemMaps; this draws any of them. Wires are
 * drawn in the browser from where the parts actually sit, so the same map
 * works as a spread on a wide screen and as a stack on a phone.
 */
import { systemMaps, type SystemMapId } from '../data/systemMaps';
import type {
  Box,
  EdgeKind,
  MapNode,
  MapZone,
  Text,
} from '../data/systemMaps/types';
import { glyphs, drawings } from './systemMap/art';
import { t, resolveLocale } from '../lib/i18n';

interface Props {
  id: SystemMapId;
  heading: string;
}

const { id, heading } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const map = systemMaps[id];
const say = (text: Text | string) =>
  typeof text === 'string' ? text : text[locale];

const uid = `smap-${map.id}`;
const nodeById = new Map(map.nodes.map((node) => [node.id, node]));
const zoneById = new Map(map.zones.map((zone) => [zone.id, zone]));
const hosts = new Set(map.zones.flatMap((zone) => zone.host ?? []));

const topZones = map.zones.filter((zone) => !zone.parent);
const childZones = (zone: MapZone) =>
  map.zones.filter((child) => child.parent === zone.id);
const partsOf = (zone: MapZone) =>
  map.nodes.filter((node) => node.zone === zone.id && !hosts.has(node.id));

// Every box sits in its parent's box, as percentages of it.
const whole: Box = { x: 0, y: 0, ...map.size };
const pct = (n: number) => `${+n.toFixed(3)}%`;
const boxStyle = (box: Box, within: Box) =>
  [
    `--zx:${pct(((box.x - within.x) / within.w) * 100)}`,
    `--zy:${pct(((box.y - within.y) / within.h) * 100)}`,
    `--zw:${pct((box.w / within.w) * 100)}`,
    `--zh:${pct((box.h / within.h) * 100)}`,
  ].join(';');
const nodeStyle = (node: MapNode, within: Box) =>
  node.at
    ? `--x:${pct(((node.at.x - within.x) / within.w) * 100)};--y:${pct(((node.at.y - within.y) / within.h) * 100)}`
    : '';

// A node's kicker: the place it lives; a zone's host names its parent.
const placeOf = (node: MapNode) => {
  const zone = zoneById.get(node.zone)!;
  if (!hosts.has(node.id)) return say(zone.label);
  const parent = zone.parent ? zoneById.get(zone.parent) : undefined;
  return parent ? say(parent.label) : say(zone.label);
};

const kinds: EdgeKind[] = [
  'https',
  'tailscale',
  'lan',
  'local',
  'audio',
  'training',
];
const kindLabel = (kind: EdgeKind) => t(`map_kind_${kind}`, locale);

// What each part talks to, for its panel.
const linksOf = (nodeId: string) =>
  map.edges
    .filter((edge) => edge.from === nodeId || edge.to === nodeId)
    .map((edge) => {
      const other = nodeById.get(edge.from === nodeId ? edge.to : edge.from)!;
      return { other, edge };
    });

// What a host's panel lists instead: the parts it carries.
const carried = (hostId: string) => {
  const zone = map.zones.find((z) => z.host === hostId)!;
  return map.nodes.filter((n) => n.zone === zone.id && n.id !== hostId);
};

// The browser needs the wiring, the hosts and the walkthroughs; the words
// arrive already in the reader's language.
const clientData = {
  edges: map.edges.map((edge) => ({
    from: edge.from,
    to: edge.to,
    kind: edge.kind,
    label: say(edge.label),
  })),
  hosts: Object.fromEntries(
    map.zones
      .filter((zone) => zone.host)
      .map((zone) => [
        zone.host!,
        {
          zones: [
            zone.id,
            ...map.zones.filter((z) => z.parent === zone.id).map((z) => z.id),
          ],
          nodes: carried(zone.host!).map((n) => n.id),
        },
      ]),
  ),
  walks: Object.fromEntries(
    map.walkthroughs.map((walk) => [
      walk.id,
      walk.steps.map((step) => ({
        nodes: step.nodes,
        caption: say(step.caption),
      })),
    ]),
  ),
  stepOf: t('map_step', locale, { n: '{n}', total: '{total}' }),
};
---

<section class="smap" data-smap aria-labelledby={`${uid}-h`}>
  <header class="smap-head" data-reveal>
    <h2 id={`${uid}-h`}>{heading}</h2>
    <p>{t('map_intro', locale)}</p>
  </header>

  <div class="smap-walks" role="group" aria-label={t('map_walks', locale)}>
    <span class="smap-walks-label" aria-hidden="true"
      >{t('map_walks', locale)}</span
    >
    {
      map.walkthroughs.map((walk, i) => (
        <button type="button" data-walk={walk.id} aria-pressed="false">
          <span class="smap-walk-n" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          {say(walk.title)}
        </button>
      ))
    }
  </div>

  <div class="smap-body">
    <div class="smap-stage">
      <div
        class="smap-canvas"
        data-smap-canvas
        role="group"
        aria-label={say(map.label)}
        style={`--ratio:${map.size.w}/${map.size.h}`}
      >
        <svg class="smap-wires" data-smap-wires aria-hidden="true"></svg>
        <svg class="smap-wires smap-labels" data-smap-labels aria-hidden="true"
        ></svg>

        {
          topZones.map((zone) => (
            <div
              class:list={['smap-zone', { 'smap-tunnel': zone.tunnel }]}
              data-zone={zone.id}
              style={boxStyle(zone.box, whole)}
            >
              {zone.host ? (
                <button
                  type="button"
                  class="smap-node smap-host"
                  data-node={zone.host}
                  aria-expanded="false"
                  aria-controls={`${uid}-panel`}
                >
                  <svg
                    class="smap-glyph"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    set:html={glyphs[nodeById.get(zone.host)!.glyph]}
                  />
                  <span class="smap-text">
                    <span class="smap-name">
                      {say(nodeById.get(zone.host)!.label)}
                    </span>
                    <span class="smap-sub">
                      {say(nodeById.get(zone.host)!.sub ?? '')}
                    </span>
                  </span>
                </button>
              ) : (
                <span class="smap-zone-label">{say(zone.label)}</span>
              )}

              {childZones(zone).map((child) => (
                <div
                  class="smap-zone smap-subzone"
                  data-zone={child.id}
                  style={boxStyle(child.box, zone.box)}
                >
                  {child.host ? (
                    <button
                      type="button"
                      class="smap-node smap-host"
                      data-node={child.host}
                      aria-expanded="false"
                      aria-controls={`${uid}-panel`}
                    >
                      <svg
                        class="smap-glyph"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        set:html={glyphs[nodeById.get(child.host)!.glyph]}
                      />
                      <span class="smap-text">
                        <span class="smap-name">
                          {say(nodeById.get(child.host)!.label)}
                        </span>
                        <span class="smap-sub">
                          {say(nodeById.get(child.host)!.sub ?? '')}
                        </span>
                      </span>
                    </button>
                  ) : (
                    <span class="smap-zone-label">{say(child.label)}</span>
                  )}
                  <div class="smap-parts">
                    {partsOf(child).map((node) => (
                      <button
                        type="button"
                        class:list={['smap-node', { 'smap-layer': node.layer }]}
                        data-node={node.id}
                        style={nodeStyle(node, child.box)}
                        aria-expanded="false"
                        aria-controls={`${uid}-panel`}
                      >
                        <svg
                          class="smap-glyph"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                          set:html={glyphs[node.glyph]}
                        />
                        <span class="smap-text">
                          <span class="smap-name">{say(node.label)}</span>
                          {node.sub && (
                            <span class="smap-sub">{say(node.sub)}</span>
                          )}
                        </span>
                      </button>
                    ))}
                  </div>
                </div>
              ))}

              <div class="smap-parts">
                {partsOf(zone).map((node) => (
                  <button
                    type="button"
                    class:list={['smap-node', { 'smap-layer': node.layer }]}
                    data-node={node.id}
                    style={nodeStyle(node, zone.box)}
                    aria-expanded="false"
                    aria-controls={`${uid}-panel`}
                  >
                    <svg
                      class="smap-glyph"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      set:html={glyphs[node.glyph]}
                    />
                    <span class="smap-text">
                      <span class="smap-name">{say(node.label)}</span>
                      {node.sub && (
                        <span class="smap-sub">{say(node.sub)}</span>
                      )}
                    </span>
                  </button>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="smap-player" data-smap-player hidden>
        <ol class="smap-dots" aria-hidden="true" data-smap-dots></ol>
        <p class="smap-caption" aria-live="polite">
          <span class="smap-step-n" data-smap-step-n></span>
          <span data-smap-caption></span>
        </p>
        <div class="smap-controls">
          <button
            type="button"
            data-smap-prev
            aria-label={t('map_prev', locale)}
            title={t('map_prev', locale)}
          >
            <svg viewBox="0 0 16 16" aria-hidden="true"
              ><path d="M10 3 L5 8 L10 13"></path></svg
            >
          </button>
          <button
            type="button"
            data-smap-play
            data-play={t('map_play', locale)}
            data-pause={t('map_pause', locale)}
            aria-label={t('map_pause', locale)}
            title={t('map_pause', locale)}
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" class="smap-i-pause"
              ><path d="M5.5 3.5 V12.5 M10.5 3.5 V12.5"></path></svg
            >
            <svg viewBox="0 0 16 16" aria-hidden="true" class="smap-i-play"
              ><path d="M5 3 L12.5 8 L5 13 Z"></path></svg
            >
          </button>
          <button
            type="button"
            data-smap-next
            aria-label={t('map_next', locale)}
            title={t('map_next', locale)}
          >
            <svg viewBox="0 0 16 16" aria-hidden="true"
              ><path d="M6 3 L11 8 L6 13"></path></svg
            >
          </button>
          <button
            type="button"
            class="smap-end"
            data-smap-end
            aria-label={t('map_end', locale)}
            title={t('map_end', locale)}
          >
            <svg viewBox="0 0 16 16" aria-hidden="true"
              ><path d="M4 4 L12 12 M12 4 L4 12"></path></svg
            >
          </button>
        </div>
      </div>
    </div>

    <div class="smap-side">
      <div class="smap-rest" data-smap-rest>
        <div class="smap-intro" data-smap-intro>
          <p class="smap-kicker">{t('map_pick_k', locale)}</p>
          <h3>{t('map_pick_h', locale)}</h3>
          <p>{t('map_pick_b', locale)}</p>
        </div>

        {
          map.walkthroughs.map((walk) => (
            <div class="smap-steps" data-smap-steps={walk.id} hidden>
              <p class="smap-kicker">{t('map_walks', locale)}</p>
              <h3>{say(walk.title)}</h3>
              <ol>
                {walk.steps.map((step, i) => (
                  <li>
                    <button type="button" data-smap-goto-step={i}>
                      {say(step.caption)}
                    </button>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }

        <div class="smap-legend">
          <p class="smap-kicker">{t('map_legend', locale)}</p>
          <ul>
            {
              kinds.map((kind) => (
                <li>
                  <svg viewBox="0 0 40 10" aria-hidden="true">
                    <path class={`smap-line k-${kind}`} d="M2 5 H38" />
                  </svg>
                  {kindLabel(kind)}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <aside
        class="smap-panel"
        id={`${uid}-panel`}
        data-smap-panel
        aria-label={t('map_panel', locale)}
        inert
      >
        <button
          type="button"
          class="smap-close"
          data-smap-close
          aria-label={t('map_close', locale)}
          title={t('map_close', locale)}
        >
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path d="M3 3 L13 13 M13 3 L3 13"></path>
          </svg>
        </button>

        {
          map.nodes.map((node) => (
            <section data-panel={node.id} hidden>
              <p class="smap-kicker">{placeOf(node)}</p>
              <h3 tabindex="-1">{say(node.label)}</h3>
              {node.sub && <p class="smap-panel-sub">{say(node.sub)}</p>}
              {node.drawing && (
                <figure class="smap-drawing">
                  <svg
                    viewBox="0 0 200 140"
                    role="img"
                    aria-label={say(drawings[node.drawing].alt)}
                    set:html={drawings[node.drawing].svg}
                  />
                </figure>
              )}
              <p class="smap-panel-body">{say(node.body)}</p>
              <ul class="smap-tags">
                {node.tags.map((tag) => (
                  <li>{say(tag)}</li>
                ))}
              </ul>
              {hosts.has(node.id) ? (
                <>
                  <p class="smap-kicker">{t('map_carries', locale)}</p>
                  <ul class="smap-links">
                    {carried(node.id).map((part) => (
                      <li>
                        <button type="button" data-smap-goto={part.id}>
                          <svg
                            class="smap-glyph"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            set:html={glyphs[part.glyph]}
                          />
                          <span>{say(part.label)}</span>
                        </button>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                linksOf(node.id).length > 0 && (
                  <>
                    <p class="smap-kicker">{t('map_links', locale)}</p>
                    <ul class="smap-links">
                      {linksOf(node.id).map(({ other, edge }) => (
                        <li>
                          <button type="button" data-smap-goto={other.id}>
                            <svg
                              class="smap-glyph"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                              set:html={glyphs[other.glyph]}
                            />
                            <span>{say(other.label)}</span>
                            <span class="smap-via">
                              <svg viewBox="0 0 28 10" aria-hidden="true">
                                <path
                                  class={`smap-line k-${edge.kind}`}
                                  d="M2 5 H26"
                                />
                              </svg>
                              {say(edge.label)}
                            </span>
                          </button>
                        </li>
                      ))}
                    </ul>
                  </>
                )
              )}
            </section>
          ))
        }
      </aside>
    </div>
  </div>

  <script
    type="application/json"
    data-smap-data
    set:html={JSON.stringify(clientData)}
  />
</section>

<script>
  import '../scripts/systemMap.ts';
</script>

<style is:global>
  .smap {
    --smap-paper: var(--canvas);
    --smap-line: color-mix(in srgb, var(--ink) 16%, transparent);
    --smap-zone: color-mix(in srgb, var(--ink) 2.2%, var(--canvas));
    --smap-ease: cubic-bezier(0.22, 0.8, 0.2, 1);
    /* Wider than the text column: a map needs room. */
    --smap-width: min(1280px, calc(100vw - 32px));
    width: var(--smap-width);
    margin-inline: calc((100% - var(--smap-width)) / 2);
    padding: 72px 0 24px;
  }

  .smap-head {
    max-width: 1000px;
    margin: 0 auto;
    padding-inline: max(0px, calc((var(--smap-width) - 1000px) / 2));
  }
  .smap-head h2 {
    margin: 0;
    padding-top: 20px;
    border-top: 1px solid var(--color-ink);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .smap-head p {
    max-width: 620px;
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-body);
  }

  /* ── Walkthroughs ─────────────────────────────────────────── */
  .smap-walks {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    max-width: 1000px;
    margin: 26px auto 22px;
    padding-inline: max(0px, calc((var(--smap-width) - 1000px) / 2));
    box-sizing: content-box;
  }
  .smap-walks-label {
    margin-right: 6px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .smap-walks button {
    display: inline-flex;
    align-items: baseline;
    gap: 9px;
    padding: 8px 15px 8px 12px;
    border: 1px solid var(--smap-line);
    border-radius: 999px;
    background: var(--smap-paper);
    font: italic 400 16px/1.2 var(--font-serif);
    color: var(--color-ink);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background 0.2s ease;
  }
  .smap-walk-n {
    font: 500 10px/1 var(--font-sans);
    font-style: normal;
    letter-spacing: 0.12em;
    color: var(--color-faint);
  }
  .smap-walks button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .smap-walks button[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--canvas);
  }
  .smap-walks button[aria-pressed='true'] .smap-walk-n {
    color: color-mix(in srgb, var(--canvas) 70%, transparent);
  }

  /* ── The map ──────────────────────────────────────────────── */
  .smap-body {
    display: grid;
    gap: 22px;
  }
  .smap-stage {
    position: relative;
    min-width: 0;
  }
  .smap-canvas {
    position: relative;
    aspect-ratio: var(--ratio);
    container-type: inline-size;
    font-size: clamp(10.5px, 1.42cqw, 14px);
  }
  .smap-wires {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .smap-labels {
    z-index: 3;
  }

  .smap-zone {
    position: absolute;
    left: var(--zx);
    top: var(--zy);
    width: var(--zw);
    height: var(--zh);
    box-sizing: border-box;
    border: 1px solid var(--smap-line);
    border-radius: 18px;
    /* Each zone hands its paper to its parts' quiet state. */
    --zone-bg: var(--smap-zone);
    background: var(--zone-bg);
    transition:
      border-color 0.3s ease,
      opacity 0.3s ease;
  }
  .smap-subzone {
    border-radius: 14px;
    border-color: color-mix(in srgb, var(--ink) 24%, transparent);
    --zone-bg: color-mix(in srgb, var(--ink) 3.5%, var(--canvas));
  }
  .smap-zone[data-zone='training'],
  .smap-zone[data-zone='services'] {
    border-style: dashed;
    --zone-bg: var(--smap-paper);
  }
  /* A passage, not a place: on the wide map only its gateway shows. */
  .smap-tunnel {
    border: 0;
    --zone-bg: var(--smap-paper);
    background: none;
  }
  .smap-tunnel .smap-zone-label {
    display: none;
  }
  .smap-tunnel .smap-node {
    border: 1.5px dashed color-mix(in srgb, var(--accent) 70%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 7%, var(--smap-paper));
    box-shadow: 0 0 0 5px var(--smap-paper);
  }
  .smap-tunnel .smap-glyph {
    color: var(--accent);
  }
  .smap-zone.is-active {
    border-color: var(--accent);
  }
  .smap-zone-label {
    position: absolute;
    top: 0;
    left: 16px;
    z-index: 2;
    transform: translateY(-50%);
    padding: 0 8px;
    background: var(--smap-paper);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-muted);
  }

  /* A part: a small card the wires run behind. */
  .smap-node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.55em;
    box-sizing: border-box;
    padding: 0.42em 0.85em 0.42em 0.5em;
    transform: translate(-50%, -50%);
    border: 1px solid var(--smap-line);
    border-radius: 0.85em;
    background: var(--smap-paper);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 4%, transparent);
    font: inherit;
    text-align: left;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      opacity 0.3s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      color 0.25s ease;
  }
  .smap-node:hover {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .smap-node:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .smap-glyph {
    flex: none;
    width: 1.7em;
    height: 1.7em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--color-body);
    transition: color 0.25s ease;
  }
  .smap-glyph .a {
    stroke: var(--accent);
  }
  .smap-glyph .f {
    stroke-opacity: 0.45;
  }
  .smap-text {
    display: grid;
    min-width: 0;
  }
  .smap-name {
    font: italic 400 1.1em/1.15 var(--font-serif);
    letter-spacing: -0.005em;
    white-space: nowrap;
  }
  .smap-sub {
    margin-top: 0.22em;
    font-size: 0.64em;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.09em;
    white-space: nowrap;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* A zone's host is its title, sitting on the zone's top edge. */
  .smap-host {
    left: 16px;
    top: 0;
    max-width: none;
    transform: translateY(-50%);
    padding: 0.32em 0.85em 0.32em 0.45em;
    border-radius: 999px;
