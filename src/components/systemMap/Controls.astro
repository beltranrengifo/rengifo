---
/* A walkthrough's controls: back, play or pause, forward, end. */
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="smap-controls">
  <button
    type="button"
    data-smap-prev
    aria-label={t('map_prev', locale)}
    title={t('map_prev', locale)}
  >
    <svg viewBox="0 0 16 16" aria-hidden="true"
      ><path d="M10 3 L5 8 L10 13"></path></svg
    >
  </button>
  <button
    type="button"
    data-smap-play
    data-play={t('map_play', locale)}
    data-pause={t('map_pause', locale)}
    aria-label={t('map_pause', locale)}
    title={t('map_pause', locale)}
  >
    <svg viewBox="0 0 16 16" aria-hidden="true" class="smap-i-pause"
      ><path d="M5.5 3.5 V12.5 M10.5 3.5 V12.5"></path></svg
    >
    <svg viewBox="0 0 16 16" aria-hidden="true" class="smap-i-play"
      ><path d="M5 3 L12.5 8 L5 13 Z"></path></svg
    >
  </button>
  <button
    type="button"
    data-smap-next
    aria-label={t('map_next', locale)}
    title={t('map_next', locale)}
  >
    <svg viewBox="0 0 16 16" aria-hidden="true"
      ><path d="M6 3 L11 8 L6 13"></path></svg
    >
  </button>
  <button
    type="button"
    class="smap-end"
    data-smap-end
    aria-label={t('map_end', locale)}
    title={t('map_end', locale)}
  >
    <svg viewBox="0 0 16 16" aria-hidden="true"
      ><path d="M4 4 L12 12 M12 4 L4 12"></path></svg
    >
  </button>
</div>
