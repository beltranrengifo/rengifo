---
import '../styles/global.css';
import { t, localisedPath, type Locale } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
// Page-specific copy wins; otherwise the site-wide pair, in this locale.
const title = Astro.props.title ?? t('ui_meta_title', lang);
const description = Astro.props.description ?? t('ui_meta_description', lang);

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;

// hreflang: every page exists in both locales at mirrored paths.
const alternates = Astro.site
  ? (['en', 'es'] as const).map((locale) => ({
      locale,
      href: new URL(localisedPath(Astro.url.pathname, lang, locale), Astro.site)
        .href,
    }))
  : [];

// Share card per locale — generated by `npm run og`, committed to /public.
const ogImage = Astro.site
  ? new URL(lang === 'es' ? '/og-es.png' : '/og.png', Astro.site).href
  : undefined;
const ogImageAlt =
  lang === 'es'
    ? 'Beltrán Rengifo — Ingeniero de Software Senior, Madrid'
    : 'Beltrán Rengifo — Senior Product Engineer, Madrid';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F6F5F2" />
    {canonical && <link rel="canonical" href={canonical.href} />}
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={alt.href} />
      ))
    }
    {
      alternates.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400;0,500;0,600;1,400&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Beltrán Rengifo" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta
      property="og:locale:alternate"
      content={lang === 'es' ? 'en_GB' : 'es_ES'}
    />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:alt" content={ogImageAlt} />
        </>
      )
    }

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}

    <title>{title}</title>

    <script>
      import '../scripts/resume.ts';
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
